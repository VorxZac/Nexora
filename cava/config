## CAVA - tema Hyprland / niri (Catppuccin Mocha)
## Gradiente vertical: de teal en la base a rosa en los picos.
## Las lineas con ; muestran valores por defecto.

[general]

# Recarga la config automaticamente al guardar (muy util mientras ajustas colores)
live-config = 1

framerate = 60

# Sensibilidad automatica: baja sola si las barras se pegan al techo
autosens = 1
sensitivity = 100

# 0 = llena todo el ancho de la terminal
bars = 0
bar_width = 2
bar_spacing = 1

# Centra las barras si sobra espacio
center_align = 1
max_height = 100

# Rango de frecuencias visualizado
lower_cutoff_freq = 40
higher_cutoff_freq = 12000

# Segundos sin audio antes de dormir (ahorra CPU). 0 = desactivado
sleep_timer = 30


[input]

# Por defecto cava elige solo (oss, pipewire, sndio, jack, pulse, alsa...).
# Si no reacciona al audio, descomenta el que uses:
; method = pipewire
; source = auto
; method = pulse
; source = auto


[output]

method = noncurses
orientation = bottom
channels = stereo
reverse = 0

# Barrita plana en el fondo cuando no suena nada
show_idle_bar_heads = 1

# Sin etiquetas de frecuencia, mas limpio
xaxis = none

# Quita parpadeos en Alacritty. Si tu terminal lo soporta (kitty, foot, wezterm) puedes activarlo
; synchronized_sync = 1


[color]
# walltheme: degradado generado desde tu fondo de pantalla
gradient = 1
gradient_color_1 = '#05062C'
gradient_color_2 = '#343238'
gradient_color_3 = '#8856B3'
gradient_color_4 = '#5A67DA'
gradient_color_5 = '#7589FA'
gradient_color_6 = '#C1BC00'
gradient_color_7 = '#F8F47C'
gradient_color_8 = '#F7F5E8'

# Sin fondo propio: respeta la transparencia de tu terminal
background = default
foreground = default

# Gradiente vertical, de la base de las barras hacia arriba.
# Colores Catppuccin Mocha: teal, sky, sapphire, blue, lavender, mauve, pink, flamingo

; horizontal_gradient = 0


[smoothing]

# Suavizado estilo "monstercat": barras conectadas, aspecto fluido
monstercat = 1
waves = 0

# 0 = rapido pero ruidoso, 100 = lento y muy suave
noise_reduction = 70


[eq]

# Ecualizador visual: realza un poco graves y agudos para que se vea mas vivo
1 = 1.2
2 = 1
3 = 1
4 = 1.15
5 = 1.3
