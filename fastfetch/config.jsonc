{
    "$schema":  "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
    "logo":  {
                 "type":  "sixel",
                 "source":  "~/.config/fastfetch/L2.png",
                 "width":  40,
                 "padding":  {
                                 "top":  0,
                                 "right":  3
                             },
                 "color":  {
                               "1":  "#A7D8F0"
                           }
             },
    "display":  {
                    "separator":  "  "
                },
    "modules":  [
                    {
                        "type":  "title",
                        "format":  "lua:local args=...; local host=args.hostName or ''; if host:sub(1,8):upper()=='DESKTOP-' then host=host:sub(9) end; local e=string.char(27); local c1=e..'[1;38;2;255;255;255;48;2;5;6;44m'; local c2=e..'[38;2;5;6;44;48;2;51;1;98m'; local c3=e..'[1;38;2;255;255;255;48;2;51;1;98m'; local c4=e..'[38;2;51;1;98;48;2;52;50;56m'; local c5=e..'[1;38;2;255;255;255;48;2;52;50;56m'; local c6=e..'[38;2;52;50;56;49m'; return c1..' \uf108 '..c2..'\ue0b0'..c3..' '..host..' '..c4..'\ue0b0'..c5..' \uf007 Zach '..c6..'\ue0b0'..e..'[0m'"
                    },
                    "break",
                    {
                        "type":  "os",
                        "key":  "󰣇  \u003e",
                        "keyColor":  "#7BC8E8",
                        "format":  "{name} {version} ({codename}) {arch}"
                    },
                    {
                        "type":  "kernel",
                        "key":  "󰌢  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "host",
                        "key":  "󰟀  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "shell",
                        "key":  "󰆍  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "terminal",
                        "key":  "󰞷  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "wm",
                        "key":  "󰖲  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "wmtheme",
                        "key":  "󰉼  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "icons",
                        "key":  "󰀻  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "terminalfont",
                        "key":  "󰛖  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "packages",
                        "key":  "󰏖  \u003e",
                        "keyColor":  "#7BC8E8",
                        "format":  "{all} packages"
                    },
                    {
                        "type":  "cpu",
                        "key":  "󰻠  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "gpu",
                        "key":  "󰢮  \u003e",
                        "keyColor":  "#7BC8E8",
                        "format":  "{name} @ {frequency} ({driver})"
                    },
                    {
                        "type":  "memory",
                        "key":  "󰍛  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "disk",
                        "key":  "󰋊  \u003e",
                        "keyColor":  "#7BC8E8"
                    },
                    {
                        "type":  "monitor",
                        "key":  "󰍹  \u003e",
                        "keyColor":  "#7BC8E8",
                        "format":  "{name} ({width}x{height}) @ {refresh-rate} Hz"
                    },
                    "break",
                    {
                        "type":  "custom",
                        "format":  "{#1;38;2;255;255;255;48;2;5;6;44}    {#1;38;2;255;255;255;48;2;51;1;98}    {#1;38;2;255;255;255;48;2;52;50;56}    {#1;38;2;255;255;255;48;2;98;68;132}    {#1;38;2;255;255;255;48;2;136;86;179}    {#1;38;2;255;255;255;48;2;228;2;45}    {#1;38;2;255;255;255;48;2;90;103;218}    {#1;38;2;255;255;255;48;2;161;97;134}    {#1;38;2;255;255;255;48;2;117;137;250}    {#1;38;2;255;255;255;48;2;159;160;227}    {#1;38;2;255;255;255;48;2;193;188;0}    {#1;38;2;255;255;255;48;2;241;235;0}    {#1;38;2;255;255;255;48;2;248;244;124}    {#1;38;2;255;255;255;48;2;247;245;232}    {#1;38;2;255;255;255;48;2;247;245;232} {#}"
                    },
                    {
                        "type":  "custom",
                        "format":  "{#1;38;2;255;255;255;48;2;5;6;44}    {#1;38;2;255;255;255;48;2;51;1;98}    {#1;38;2;255;255;255;48;2;52;50;56}    {#1;38;2;255;255;255;48;2;98;68;132}    {#1;38;2;255;255;255;48;2;136;86;179}    {#1;38;2;255;255;255;48;2;228;2;45}    {#1;38;2;255;255;255;48;2;90;103;218}    {#1;38;2;255;255;255;48;2;161;97;134}    {#1;38;2;255;255;255;48;2;117;137;250}    {#1;38;2;255;255;255;48;2;159;160;227}    {#1;38;2;255;255;255;48;2;193;188;0}    {#1;38;2;255;255;255;48;2;241;235;0}    {#1;38;2;255;255;255;48;2;248;244;124}    {#1;38;2;255;255;255;48;2;247;245;232}    {#1;38;2;255;255;255;48;2;247;245;232} {#}"
                    }
                ]
}
